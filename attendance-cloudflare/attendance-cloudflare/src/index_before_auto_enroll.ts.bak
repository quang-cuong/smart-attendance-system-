    if (!classCode || !className || !Number.isFinite(latitude) || !Number.isFinite(longitude) || !Number.isFinite(radius)) {
      return jsonResponse({ success: false, message: "Thiếu hoặc sai dữ liệu lớp học" }, 400);
    }

    await env.attendance_db
