// ================= V4 Phase 2: enrollment + schedule =================
async function handleV4ClassStudents(request:Request,env:Env,classId:number):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=="admin")return jsonResponse({success:false,message:"Chỉ Admin được quản lý danh sách lớp."},403);
 const cls=await env.attendance_db.prepare("SELECT id FROM classes WHERE id=?").bind(classId).first();
 if(!cls)return jsonResponse({success:false,message:"Lớp không tồn tại."},404);
 try{
  if(request.method==="GET"){
   const res=await env.attendance_db.prepare(`SELECT u.id,u.student_code,u.full_name,cs.enrolled_at FROM class_students cs JOIN users u ON cs.student_id=u.id WHERE cs.class_id=? ORDER BY u.student_code`).bind(classId).all();
   return jsonResponse({success:true,data:res.results});
  }
  const body=await request.json() as {student_ids?:unknown;all?:boolean};
  if(request.method==="POST"){
   let ids:number[]=[];
   if(body.all===true){const all=await env.attendance_db.prepare("SELECT id FROM users").all<{id:number}>();ids=all.results.map(x=>x.id)}
   else if(Array.isArray(body.student_ids))ids=[...new Set(body.student_ids)].map(Number);
   if(ids.length===0)return jsonResponse({success:false,message:"Chưa chọn sinh viên."},400);
   if(ids.length>5000||ids.some(id=>!Number.isSafeInteger(id)||id<1))return jsonResponse({success:false,message:"ID sinh viên không hợp lệ."},400);
   // Batch giới hạn mỗi đợt để không vượt giới hạn API D1.
   let changes=0;
   for(let i=0;i<ids.length;i+=80){
    const chunk=ids.slice(i,i+80);
    const result=await env.attendance_db.batch(chunk.map(id=>env.attendance_db.prepare("INSERT OR IGNORE INTO class_students(class_id,student_id) SELECT ?,id FROM users WHERE id=?").bind(classId,id)));
    changes+=result.reduce((n,x)=>n+(x.meta.changes??0),0);
   }
   return jsonResponse({success:true,added:changes,requested:ids.length,message:`Đã xếp ${changes} sinh viên mới vào lớp.`});
  }
  if(request.method==="DELETE"){
   if(!Array.isArray(body.student_ids)||!body.student_ids.length||body.student_ids.length>5000)return jsonResponse({success:false,message:"Chọn các sinh viên cần gỡ khỏi lớp."},400);
   const ids=[...new Set(body.student_ids)].map(Number);
   if(ids.some(id=>!Number.isSafeInteger(id)||id<1))return jsonResponse({success:false,message:"ID không hợp lệ."},400);
   let removed=0;
   for(let i=0;i<ids.length;i+=80){const chunk=ids.slice(i,i+80);const r=await env.attendance_db.prepare(`DELETE FROM class_students WHERE class_id=? AND student_id IN (${chunk.map(()=>'?').join(',')})`).bind(classId,...chunk).run();removed+=r.meta.changes??0;}
   return jsonResponse({success:true,removed,message:`Đã gỡ ${removed} sinh viên khỏi lớp.`});
  }
 }catch(e){return jsonResponse({success:false,message:"Không thể cập nhật thành viên lớp",error:String(e)},500)}
 return jsonResponse({success:false,message:"Phương thức không hợp lệ"},405);
}
async function handleV4Schedules(request:Request,env:Env,scheduleId?:number):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=="admin")return jsonResponse({success:false,message:"Chỉ Admin được chỉnh thời khóa biểu."},403);
 try{
  if(request.method==="GET"){
   const r=await env.attendance_db.prepare(`SELECT s.*,c.class_code,c.class_name FROM class_schedules s JOIN classes c ON c.id=s.class_id ORDER BY s.starts_at DESC LIMIT 500`).all();
   return jsonResponse({success:true,data:r.results});
  }
  if(request.method==="DELETE"){
   if(!scheduleId)return jsonResponse({success:false,message:"Thiếu ID lịch"},400);
   const r=await env.attendance_db.prepare("DELETE FROM class_schedules WHERE id=?").bind(scheduleId).run();
   return jsonResponse({success:true,deleted:r.meta.changes??0});
  }
  const body=await request.json() as {class_id?:number;subject_name?:string;room?:string;starts_at?:string;ends_at?:string;attendance_duration_seconds?:number;on_time_seconds?:number};
  const classId=Number(body.class_id),subject=String(body.subject_name||'').trim(),room=String(body.room||'').trim();
  const start=String(body.starts_at||''),end=String(body.ends_at||'');
  const duration=Number(body.attendance_duration_seconds??180),ontime=Number(body.on_time_seconds??60);
  if(!Number.isSafeInteger(classId)||classId<1||!subject||subject.length>200||room.length>150||!Number.isFinite(Date.parse(start))||!Number.isFinite(Date.parse(end))||Date.parse(end)<=Date.parse(start)||!Number.isInteger(duration)||duration<60||duration>3600||!Number.isInteger(ontime)||ontime<0||ontime>=duration){
   return jsonResponse({success:false,message:"Dữ liệu lịch không hợp lệ; phiên phải dài 1–60 phút, đúng giờ ngắn hơn thời lượng."},400);
  }
  const cls=await env.attendance_db.prepare("SELECT id FROM classes WHERE id=?").bind(classId).first();
  if(!cls)return jsonResponse({success:false,message:"Lớp không tồn tại"},404);
  if(request.method==="POST"){
   const r=await env.attendance_db.prepare(`INSERT INTO class_schedules(class_id,subject_name,room,starts_at,ends_at,attendance_duration_seconds,on_time_seconds) VALUES(?,?,?,?,?,?,?)`).bind(classId,subject,room,start,end,duration,ontime).run();
   return jsonResponse({success:true,id:r.meta.last_row_id,message:"Đã tạo lịch học."},201);
  }
  if(request.method==="PUT"&&scheduleId){
   const r=await env.attendance_db.prepare(`UPDATE class_schedules SET class_id=?,subject_name=?,room=?,starts_at=?,ends_at=?,attendance_duration_seconds=?,on_time_seconds=? WHERE id=? AND status='scheduled'`).bind(classId,subject,room,start,end,duration,ontime,scheduleId).run();
   return jsonResponse({success:!!r.meta.changes,updated:r.meta.changes??0,message:r.meta.changes?'Đã cập nhật lịch học.':'Không tìm thấy lịch có thể sửa.'},r.meta.changes?200:404);
  }
 }catch(e){return jsonResponse({success:false,message:"Lỗi xử lý lịch học",error:String(e)},500)}
 return jsonResponse({success:false,message:"Phương thức không hợp lệ."},405);
}
// Sinh viên đã đăng nhập chỉ xem lớp và lịch của chính mình, chưa mở phiên điểm danh.
async function handleV4MySchedules(request:Request,env:Env):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=="student")return jsonResponse({success:false,message:"Yêu cầu tài khoản sinh viên."},403);
 try{
  const r=await env.attendance_db.prepare(`SELECT s.id,s.class_id,s.subject_name,s.room,s.starts_at,s.ends_at,s.attendance_duration_seconds,s.on_time_seconds,s.status,c.class_code,c.class_name FROM student_accounts a JOIN class_students cs ON cs.student_id=a.user_id JOIN class_schedules s ON s.class_id=cs.class_id JOIN classes c ON c.id=s.class_id WHERE a.id=? AND a.must_change_password=0 AND s.status='scheduled' AND s.ends_at>=? ORDER BY s.starts_at ASC LIMIT 100`).bind(actor.id,new Date(Date.now()-86400000).toISOString()).all();
  return jsonResponse({success:true,data:r.results});
 }catch(e){return jsonResponse({success:false,message:"Không tải được thời khóa biểu",error:String(e)},500)}
}
// ================= End V4 Phase 2 =================


// ==================== V4 PHASE 3: TIMED SESSIONS ====================
// Các trạng thái được tính bằng thời gian máy chủ; không cần cron để đánh dấu vắng.
function p3Time(value: string): number { return Date.parse(value); }
function p3Diff(lat1:number,lon1:number,lat2:number,lon2:number):number {
 const r=6371000, toRad=Math.PI/180;
 const a=Math.sin((lat2-lat1)*toRad/2)**2+Math.cos(lat1*toRad)*Math.cos(lat2*toRad)*Math.sin((lon2-lon1)*toRad/2)**2;
 return 2*r*Math.atan2(Math.sqrt(a),Math.sqrt(1-a));
}
async function p3SessionList(request:Request,env:Env):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor)return jsonResponse({success:false,message:'Cần đăng nhập.'},401);
 const now=new Date().toISOString();
 let sql=`SELECT ses.*,s.subject_name,s.room,s.on_time_seconds,s.attendance_duration_seconds,
  c.class_code,c.class_name,c.latitude,c.longitude,c.radius
  FROM attendance_sessions ses JOIN class_schedules s ON s.id=ses.schedule_id
  JOIN classes c ON c.id=s.class_id`;
 const args:unknown[]=[];
 if(actor.role==='student'){
  const row=await env.attendance_db.prepare('SELECT user_id,must_change_password FROM student_accounts WHERE id=?').bind(actor.id).first<{user_id:number;must_change_password:number}>();
  if(!row||row.must_change_password)return jsonResponse({success:false,message:'Cần đổi mật khẩu trước.'},403);
  sql+=' JOIN class_students cs ON cs.class_id=ses.class_id WHERE cs.student_id=?';args.push(row.user_id);
 } else if(actor.role==='teacher'){
  sql+=' JOIN teacher_classes tc ON tc.class_id=ses.class_id WHERE tc.account_id=?';args.push(actor.id);
 } else if(actor.role==='parent'){
  sql+=' JOIN class_students cs ON cs.class_id=ses.class_id JOIN parent_students ps ON ps.student_id=cs.student_id WHERE ps.account_id=?';args.push(actor.id);
 }
 sql+=' ORDER BY ses.id DESC LIMIT 150';
 const stmt=env.attendance_db.prepare(sql);const result=await(args.length?stmt.bind(...args).all():stmt.all());
 const rows=result.results.map((r:any)=>({...r,phase:r.closed_at||Date.now()>=p3Time(r.ends_at)?'closed':Date.now()>=p3Time(r.starts_at)?'open':'upcoming',server_now:now}));
 return jsonResponse({success:true,data:rows,server_now:now});
}
async function p3ManageSession(request:Request,env:Env,id?:number):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=='admin')return jsonResponse({success:false,message:'Chỉ Admin được quản lý phiên.'},403);
 try {
  if(request.method==='GET')return await p3SessionList(request,env);
  if(request.method==='POST'){
   const body=await request.json() as {schedule_id?:number;mode?:string};
   const scheduleId=Number(body.schedule_id);
   if(!Number.isSafeInteger(scheduleId)||scheduleId<=0)return jsonResponse({success:false,message:'schedule_id không hợp lệ.'},400);
   const sched=await env.attendance_db.prepare(`SELECT s.id,s.class_id,s.starts_at,s.status,s.attendance_duration_seconds
     FROM class_schedules s WHERE s.id=?`).bind(scheduleId).first<any>();
   if(!sched||sched.status!=='scheduled')return jsonResponse({success:false,message:'Không tìm thấy lịch học hợp lệ.'},404);
   const demo=body.mode==='demo';
   const start=demo?new Date():new Date(sched.starts_at);
   if(!Number.isFinite(start.getTime()))return jsonResponse({success:false,message:'Giờ bắt đầu không hợp lệ.'},400);
   const end=new Date(start.getTime()+Number(sched.attendance_duration_seconds)*1000);
   const res=await env.attendance_db.prepare(`INSERT INTO attendance_sessions(schedule_id,class_id,starts_at,ends_at,mode)
      VALUES(?,?,?,?,?)`).bind(sched.id,sched.class_id,start.toISOString(),end.toISOString(),demo?'demo':'scheduled').run();
   return jsonResponse({success:true,id:res.meta.last_row_id,starts_at:start.toISOString(),ends_at:end.toISOString()},201);
  }
  if(request.method==='PATCH'&&id){
   const res=await env.attendance_db.prepare('UPDATE attendance_sessions SET closed_at=? WHERE id=? AND closed_at IS NULL')
      .bind(new Date().toISOString(),id).run();
   return jsonResponse({success:!!res.meta.changes,message:res.meta.changes?'Đã đóng phiên.':'Phiên không tồn tại hoặc đã đóng.'},res.meta.changes?200:404);
  }
 }catch(e){return jsonResponse({success:false,message:'Lỗi quản lý phiên',error:String(e)},500)}
 return jsonResponse({success:false,message:'Phương thức không hợp lệ.'},405);
}
async function p3Attend(request:Request,env:Env):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=='student')return jsonResponse({success:false,message:'Chỉ sinh viên được điểm danh.'},403);
 try{
  const body=await request.json() as {session_id?:number;latitude?:number;longitude?:number;face_similarity?:number};
  const sid=Number(body.session_id),lat=Number(body.latitude),lon=Number(body.longitude),similarity=Number(body.face_similarity);
  if(!Number.isSafeInteger(sid)||sid<1||!Number.isFinite(lat)||Math.abs(lat)>90||!Number.isFinite(lon)||Math.abs(lon)>180||!Number.isFinite(similarity)||similarity<0.7||similarity>1)
   return jsonResponse({success:false,message:'Thiếu dữ liệu GPS/Face ID hợp lệ.'},400);
  const acc=await env.attendance_db.prepare('SELECT user_id,must_change_password FROM student_accounts WHERE id=?').bind(actor.id).first<{user_id:number;must_change_password:number}>();
  if(!acc||acc.must_change_password)return jsonResponse({success:false,message:'Cần đổi mật khẩu trước.'},403);
  const approvedFace=await env.attendance_db.prepare('SELECT id FROM face_data WHERE user_id=?').bind(acc.user_id).first();
  if(!approvedFace)return jsonResponse({success:false,message:'Chưa có khuôn mặt được Admin duyệt.'},403);
  const ses=await env.attendance_db.prepare(`SELECT ses.*,s.on_time_seconds,c.latitude AS class_lat,c.longitude AS class_lon,c.radius
    FROM attendance_sessions ses JOIN class_schedules s ON s.id=ses.schedule_id
    JOIN classes c ON c.id=ses.class_id WHERE ses.id=?`).bind(sid).first<any>();
  if(!ses)return jsonResponse({success:false,message:'Phiên không tồn tại.'},404);
  const now=Date.now(),start=p3Time(ses.starts_at),end=p3Time(ses.ends_at);
  if(ses.closed_at||now<start||now>=end)return jsonResponse({success:false,message:'Phiên chưa mở hoặc đã hết giờ.'},409);
  const member=await env.attendance_db.prepare('SELECT 1 AS ok FROM class_students WHERE class_id=? AND student_id=?').bind(ses.class_id,acc.user_id).first();
  if(!member)return jsonResponse({success:false,message:'Bạn không thuộc lớp này.'},403);
  const dist=p3Diff(lat,lon,Number(ses.class_lat),Number(ses.class_lon));
  if(dist>Number(ses.radius))return jsonResponse({success:false,message:`Ngoài bán kính lớp (${Math.round(dist)}m).`},403);
  const resultStatus=now-start<Number(ses.on_time_seconds)*1000?'on_time':'late';
  const r=await env.attendance_db.prepare(`INSERT OR IGNORE INTO session_attendance(session_id,student_id,checked_at,status,latitude,longitude,distance,face_similarity)
    VALUES(?,?,?,?,?,?,?,?)`).bind(sid,acc.user_id,new Date(now).toISOString(),resultStatus,lat,lon,dist,similarity).run();
  if(!r.meta.changes)return jsonResponse({success:false,message:'Bạn đã điểm danh phiên này.'},409);
  return jsonResponse({success:true,status:resultStatus,message:resultStatus==='on_time'?'Điểm danh đúng giờ.':'Điểm danh đi muộn.',distance:dist});
 }catch(e){return jsonResponse({success:false,message:'Không thể điểm danh',error:String(e)},500)}
}
async function p3Results(request:Request,env:Env,sessionId:number):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor)return jsonResponse({success:false,message:'Cần đăng nhập.'},401);
 const ses=await env.attendance_db.prepare('SELECT id,class_id,starts_at,ends_at,closed_at FROM attendance_sessions WHERE id=?').bind(sessionId).first<any>();
 if(!ses)return jsonResponse({success:false,message:'Phiên không tồn tại.'},404);
 if(actor.role==='teacher'){
  const ok=await env.attendance_db.prepare('SELECT 1 AS ok FROM teacher_classes WHERE class_id=? AND account_id=?').bind(ses.class_id,actor.id).first();
  if(!ok)return jsonResponse({success:false,message:'Không được xem lớp khác.'},403);
 }
 let studentId=0;
 if(actor.role==='student'){
  const x=await env.attendance_db.prepare('SELECT user_id FROM student_accounts WHERE id=?').bind(actor.id).first<{user_id:number}>();studentId=x?.user_id??0;
 }
 const finished=!!ses.closed_at||Date.now()>=p3Time(ses.ends_at);
 let sql=`SELECT u.id AS student_id,u.student_code,u.full_name,sa.checked_at,
  CASE WHEN sa.id IS NOT NULL THEN sa.status WHEN ? THEN 'absent' ELSE 'pending' END AS status
  FROM class_students cs JOIN users u ON u.id=cs.student_id
  LEFT JOIN session_attendance sa ON sa.session_id=? AND sa.student_id=u.id WHERE cs.class_id=?`;
 const args:any[]=[finished?1:0,sessionId,ses.class_id];
 if(actor.role==='student'){sql+=' AND u.id=?';args.push(studentId)}
 if(actor.role==='parent'){sql+=' AND EXISTS(SELECT 1 FROM parent_students ps WHERE ps.student_id=u.id AND ps.account_id=?)';args.push(actor.id)}
 sql+=' ORDER BY u.student_code';
 const rows=await env.attendance_db.prepare(sql).bind(...args).all();
 return jsonResponse({success:true,closed:finished,data:rows.results});
}
// ==================== END V4 PHASE 3 ====================


// Face onboarding: account-scoped enrollment and explicit Admin approval.
async function myFaceData(request: Request, env: Env): Promise<Response> {
 const actor = await getAuthUser(request,env);
 if(!actor || actor.role !== 'student')return jsonResponse({success:false,message:'Chỉ sinh viên được sử dụng.'},403);
 const acc=await env.attendance_db.prepare('SELECT user_id,must_change_password FROM student_accounts WHERE id=?')
  .bind(actor.id).first<{user_id:number;must_change_password:number}>();
 if(!acc || acc.must_change_password)return jsonResponse({success:false,message:'Vui lòng đổi mật khẩu trước.'},403);
 const approved=await env.attendance_db.prepare('SELECT embedding FROM face_data WHERE user_id=?')
  .bind(acc.user_id).first<{embedding:string}>();
 if(approved)return jsonResponse({success:true,status:'approved',embedding:approved.embedding});
 const pending=await env.attendance_db.prepare('SELECT status FROM face_registration_requests WHERE user_id=?')
  .bind(acc.user_id).first<{status:string}>();
 return jsonResponse({success:true,status:pending?.status === 'pending'?'pending':'missing'});
}
async function submitMyFace(request: Request,env:Env):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=='student')return jsonResponse({success:false,message:'Chỉ sinh viên được sử dụng.'},403);
 const acc=await env.attendance_db.prepare('SELECT user_id,must_change_password FROM student_accounts WHERE id=?')
  .bind(actor.id).first<{user_id:number;must_change_password:number}>();
 if(!acc||acc.must_change_password)return jsonResponse({success:false,message:'Vui lòng đổi mật khẩu trước.'},403);
 if(await env.attendance_db.prepare('SELECT id FROM face_data WHERE user_id=?').bind(acc.user_id).first())
  return jsonResponse({success:false,message:'Tài khoản đã có khuôn mặt được duyệt.'},409);
 const body=await request.json() as {embedding?:unknown};
 if(!Array.isArray(body.embedding)||body.embedding.length!==192||body.embedding.some(v=>typeof v!=='number'||!Number.isFinite(v)||Math.abs(v)>100))
  return jsonResponse({success:false,message:'Embedding phải là 192 số hữu hạn.'},400);
 const current=await env.attendance_db.prepare('SELECT status FROM face_registration_requests WHERE user_id=?')
  .bind(acc.user_id).first<{status:string}>();
 if(current?.status==='pending')return jsonResponse({success:false,message:'Đăng ký đang chờ Admin duyệt.'},409);
 const text=(body.embedding as number[]).join(',');
 await env.attendance_db.prepare(`INSERT INTO face_registration_requests(user_id,embedding,status,created_at,reviewed_at)
  VALUES(?,?,'pending',CURRENT_TIMESTAMP,NULL)
  ON CONFLICT(user_id) DO UPDATE SET embedding=excluded.embedding,status='pending',created_at=CURRENT_TIMESTAMP,reviewed_at=NULL`)
  .bind(acc.user_id,text).run();
 return jsonResponse({success:true,status:'pending',message:'Đã gửi đăng ký khuôn mặt; chờ Admin xác minh.'},201);
}
async function reviewFaceEnrollments(request:Request,env:Env,id?:number,action?:string):Promise<Response>{
 const actor=await getAuthUser(request,env);
 if(!actor||actor.role!=='admin')return jsonResponse({success:false,message:'Cần quyền Admin.'},403);
 if(request.method==='GET'){
  const data=await env.attendance_db.prepare(`SELECT f.id,f.user_id,u.student_code,u.full_name,f.status,f.created_at
   FROM face_registration_requests f JOIN users u ON u.id=f.user_id ORDER BY f.created_at DESC`).all();
  return jsonResponse({success:true,data:data.results});
 }
 if(!id||!['approve','reject'].includes(action||''))return jsonResponse({success:false,message:'Thao tác không hợp lệ.'},400);
 const requestRow=await env.attendance_db.prepare("SELECT user_id,embedding FROM face_registration_requests WHERE id=? AND status='pending'")
  .bind(id).first<{user_id:number;embedding:string}>();
 if(!requestRow)return jsonResponse({success:false,message:'Không có yêu cầu chờ duyệt.'},404);
 if(action==='approve'){
  // Không dùng để nhận diện một người nếu Admin chưa xác minh danh tính trực tiếp.
  await env.attendance_db.batch([
   env.attendance_db.prepare('INSERT INTO face_data(user_id,embedding) VALUES(?,?)')
    .bind(requestRow.user_id,requestRow.embedding),
   env.attendance_db.prepare("UPDATE face_registration_requests SET status='approved',reviewed_at=CURRENT_TIMESTAMP WHERE id=?").bind(id),
  ]);
 }else{
  await env.attendance_db.prepare("UPDATE face_registration_requests SET status='rejected',reviewed_at=CURRENT_TIMESTAMP WHERE id=?").bind(id).run();
 }
 return jsonResponse({success:true,message:action==='approve'?'Đã duyệt khuôn mặt.':'Đã từ chối đăng ký.'});
}

// =========================================================
// ROUTER CHÍNH CỦA CLOUDFLARE WORKER
// =========================================================
export default {
  async fetch(request, env): Promise<Response> {
    if (request.method === "OPTIONS") {
      return corsResponse();
    }

    const url = new URL(request.url);
    const path = url.pathname;
    const method = request.method;

    try {
      // -----------------------------------------------------
      // AUTH & ADMIN ROUTES (Mới)
      // -----------------------------------------------------
      if (path === "/api/admin/bootstrap" && method === "POST") {
        return await handleAdminBootstrap(request, env);
      }

      if (path === "/api/auth/register" && method === "POST") {
        return await handleRegister(request, env);
      }

      if (path === "/api/auth/login" && method === "POST") {
        return await handleLogin(request, env);
      }

      if (path === "/api/admin/registration-requests" && method === "GET") {
        return await handleGetRegistrationRequests(request, env);
      }

      const approveMatch = path.match(/^\/api\/admin\/registration-requests\/(\d+)\/approve$/);
      if (approveMatch && method === "POST") {
        return await handleApproveRequest(request, env, Number(approveMatch[1]));
      }

      const rejectMatch = path.match(/^\/api\/admin\/registration-requests\/(\d+)\/reject$/);
      if (rejectMatch && method === "POST") {
        return await handleRejectRequest(request, env, Number(rejectMatch[1]));
      }

      if (path === "/api/admin/accounts" && method === "GET") {
        return await handleGetAccounts(request, env);
      }

      if (path === "/api/admin/teacher-classes" && method === "POST") {
        return await handleAssignTeacherClass(request, env);
      }

      if (path === "/api/admin/parent-students" && method === "POST") {
        return await handleAssignParentStudent(request, env);
      }

      if (path === "/api/role/attendance" && method === "GET") {
        return await handleRoleAttendance(request, env);
      }

      if (path === "/api/admin/parent-accounts/upsert-link" && method === "POST") {
        return await handleAdminUpsertParent(request,env);
      }
      if (path === "/api/admin/student-accounts" && method === "GET") {
        return await handleAdminListStudentAccounts(request,env);
      }
      if (path === "/api/admin/student-accounts" && method === "POST") {
        return await handleAdminCreateStudentAccount(request,env);
      }
      const resetStudentMatch = path.match(/^\/api\/admin\/student-accounts\/(\d+)\/reset-password$/);
      if (resetStudentMatch && method === "POST") {
        return await handleAdminResetStudentPassword(request,env,Number(resetStudentMatch[1]));
      }
      if (path === "/api/admin/student-accounts/delete" && method === "POST") {
        return await handleAdminDeleteStudentAccounts(request,env);
      }
      if (path === "/api/role/change-password" && method === "POST") {
        return await handleRoleChangePassword(request,env);
      }
      if (path === "/api/student/change-password" && method === "POST") {
        return await handleStudentChangePassword(request,env);
      }
      if (path === "/api/student/me" && method === "GET") {
        return await handleStudentMe(request,env);
      }

      // V4 Phase 2 - lớp học và thời khóa biểu
      const memberRoute = path.match(/^\/api\/admin\/classes\/(\d+)\/students$/);
      if(memberRoute && ["GET","POST","DELETE"].includes(method)) return await handleV4ClassStudents(request,env,Number(memberRoute[1]));
      if(path==="/api/admin/schedules" && ["GET","POST"].includes(method)) return await handleV4Schedules(request,env);
      const scheduleRoute=path.match(/^\/api\/admin\/schedules\/(\d+)$/);
      if(scheduleRoute && ["PUT","DELETE"].includes(method)) return await handleV4Schedules(request,env,Number(scheduleRoute[1]));
      if(path==="/api/student/schedules" && method==="GET") return await handleV4MySchedules(request,env);

      if(path==='/api/student/my-face' && method==='GET') return await myFaceData(request,env);
      if(path==='/api/student/face-registration' && method==='POST') return await submitMyFace(request,env);
      if(path==='/api/admin/face-registrations' && method==='GET') return await reviewFaceEnrollments(request,env);
      const faceReview=path.match(/^\/api\/admin\/face-registrations\/(\d+)\/(approve|reject)$/);
      if(faceReview && method==='POST') return await reviewFaceEnrollments(request,env,Number(faceReview[1]),faceReview[2]);

      // V4 phase 3: phiên điểm danh theo giờ máy chủ
      if(path==="/api/sessions"&&method==="GET")return await p3SessionList(request,env);
      if(path==="/api/admin/sessions"&&["GET","POST"].includes(method))return await p3ManageSession(request,env);
      const sessionClose=path.match(/^\/api\/admin\/sessions\/(\d+)\/close$/);
      if(sessionClose&&method==="PATCH")return await p3ManageSession(request,env,Number(sessionClose[1]));
      if(path==="/api/student/session-attendance"&&method==="POST")return await p3Attend(request,env);
      const sessionResults=path.match(/^\/api\/sessions\/(\d+)\/results$/);
      if(sessionResults&&method==="GET")return await p3Results(request,env,Number(sessionResults[1]));

      // -----------------------------------------------------
      // ROUTE NGHIỆP VỤ CỦ (Giữ nguyên)
      // -----------------------------------------------------
      if (path === "/api/health" && method === "GET") {
        return await healthCheck(env);
      }

      if (path === "/api/students" && method === "GET") {
        return await getStudents(env);
      }

      if (path === "/api/students" && method === "POST") {
        return await createStudent(request, env);
      }

      const studentMatch = path.match(/^\/api\/students\/(\d+)$/);
      if (studentMatch && method === "PUT") {
        return await updateStudent(request, env, Number(studentMatch[1]));
      }

      if (studentMatch && method === "DELETE") {
        return await deleteStudent(env, Number(studentMatch[1]));
      }

      const studentCodeMatch = path.match(/^\/api\/students\/code\/(.+)$/);
      if (studentCodeMatch && method === "GET") {
        return await getStudentByCode(request, env);
      }

      if (path === "/api/face-data" && method === "GET") {
        return await getFaceData(env);
      }

      if (path === "/api/face-data" && method === "POST") {
        return await saveFaceData(request, env);
      }

      if (path === "/api/classes" && method === "GET") {
        return await getClasses(env);
      }

      if (path === "/api/classes" && method === "POST") {
        return await createClass(request, env);
      }

      const classMatch = path.match(/^\/api\/classes\/(\d+)$/);
      if (classMatch && method === "PUT") {
        return await updateClass(request, env, Number(classMatch[1]));
      }

      if (classMatch && method === "DELETE") {
        return await deleteClass(env, Number(classMatch[1]));
      }

      if (path === "/api/attendance" && method === "GET") {
        return await getAttendance(env);
      }

      if (path === "/api/attendance" && method === "POST") {
        return await createAttendance(request, env);
      }

      return jsonResponse({
        success: false,
        message: "API không tồn tại",
        path,
        method,
      }, 404);
    } catch (error) {
      return jsonResponse({
        success: false,
        message: "Lỗi server",
        error: String(error),
      }, 500);
    }
  },
} satisfies ExportedHandler<Env>;
